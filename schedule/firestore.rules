rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function fields() {
      return ['date', 'participantName', 'ownerUid', 'ownerName', 'ownerEmail',
              'editorUid', 'editorName', 'editorEmail', 'createdAt', 'updatedAt'];
    }
    function validNames() {
      return request.resource.data.participantName is string
        && request.resource.data.participantName.size() > 0
        && request.resource.data.participantName.size() <= 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.editorName is string
        && request.resource.data.editorName.size() > 0
        && request.resource.data.editorName.size() <= 120;
    }
    function validDate() {
      return request.resource.data.date is string
        && request.resource.data.date.matches('2026-12-(0[1-9]|1[0-9]|2[0-8])');
    }
    function actorMatchesGoogleUser() {
      return request.resource.data.editorUid == request.auth.uid
        && request.resource.data.editorEmail == request.auth.token.email;
    }
    match /registrations/{registrationId} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasAll(fields())
        && request.resource.data.keys().hasOnly(fields())
        && validDate()
        && validNames()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && actorMatchesGoogleUser()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isGoogleUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(fields())
        && request.resource.data.keys().hasOnly(fields())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'participantName', 'editorUid', 'editorName', 'editorEmail', 'updatedAt'])
        && validNames()
        && validDate()
        && actorMatchesGoogleUser()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isGoogleUser()
        && resource.data.ownerUid == request.auth.uid;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
